    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
