# ═══════════════════════════════════════════════════════════════════
# Listify — Root .env (used by docker-compose)
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# Then build & run:
#   docker compose up -d --build
# ═══════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
CLIENT_PORT=80
CLIENT_URL=http://localhost
LOG_LEVEL=info

# ── MongoDB ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=<64-byte-hex-secret>
JWT_EXPIRE=7d
JWT_ACCESS_SECRET=<64-byte-hex-secret>
JWT_REFRESH_SECRET=<64-byte-hex-secret>
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Upstash Redis ─────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Email (Gmail SMTP) ───────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="Listify <noreply@listify.com>"

# ── Google OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── AWS S3 ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket
AWS_S3_BUCKET_URL=https://your-bucket.s3.us-east-1.amazonaws.com

# ── Security ──────────────────────────────────────────────────────
BLOCKED_COUNTRIES=
GEOBLOCKING_STRICT=false
TARPITTING_ENABLED=true
ADMIN_API_KEY=your_secure_admin_key
IP_WHITELIST=127.0.0.1,::1
PASSWORD_HISTORY_LIMIT=5
PASSWORD_EXPIRATION_DAYS=90

# ── Client (Vite build-time) ─────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
